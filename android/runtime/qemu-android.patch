 static int roms_loaded;
 
+/* Binder-provided files have no pathname in Android's isolated process. */
+static gboolean fdset_get_contents(const char *filename, gchar **contents,
+                                  gsize *length, GError **error)
+{
+    int fd;
+    struct stat info;
+    gchar *data = NULL;
+    size_t offset = 0;
+
+    if (!g_str_has_prefix(filename, "/dev/fdset/")) {
+        return g_file_get_contents(filename, contents, length, error);
+    }
+    fd = qemu_open(filename, O_RDONLY | O_BINARY, NULL);
+    if (fd < 0) {
+        goto fail;
+    }
+    if (fstat(fd, &info) || info.st_size < 0 || info.st_size > 512 * MiB) {
+        goto fail;
+    }
+    data = g_try_malloc(info.st_size + 1);
+    if (!data) {
+        goto fail;
+    }
+    while (offset < info.st_size) {
+        ssize_t count = pread(fd, data + offset, info.st_size - offset, offset);
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            goto fail;
+        }
+        offset += count;
+    }
+    close(fd);
+    data[offset] = 0;
+    *contents = data;
+    *length = offset;
+    return TRUE;
+fail:
+    if (fd >= 0) {
+        close(fd);
+    }
+    g_free(data);
+    g_set_error_literal(error, G_FILE_ERROR, G_FILE_ERROR_FAILED,
+                        "Unable to read the bounded inherited image descriptor");
+    return FALSE;
+}
